@model List<Performance>
@if (Model.Count == 0)
{
    <p class="empty">まだ戦績がありません。</p>
}
else
{
    <table class="list compact numeric">
        <thead><tr><th>名前</th><th>試合</th><th>勝率</th><th>KDA</th><th>CS/分</th><th>視界</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr><td>@p.Name</td><td>@p.Games</td><td>@p.WinRate.ToString("F0")%</td><td>@p.Kda.ToString("F2")</td><td>@p.CsPerMinute.ToString("F1")</td><td>@p.VisionPerGame.ToString("F1")</td></tr>
            }
        </tbody>
    </table>
}

<Window x:Class="RiotAccounts.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:plot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
 Title="Riot Accounts" Style="{StaticResource {x:Type Window}}" Width="1220" Height="850" MinWidth="980" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="全ランク更新" Click="RefreshAll_Click"/><Button Content="接続を診断" Click="Diagnose_Click"/><Button Content="設定" Click="Settings_Click"/></StackPanel>
   <StackPanel><TextBlock Text="Riot Accounts" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="アカウントを選んで、次の一戦へ。" Foreground="#597183" Margin="0,4,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="10" Padding="16">
    <DockPanel>
     <Button DockPanel.Dock="Bottom" Content="＋ アカウントを追加" Click="Add_Click" Margin="0,16,0,0"/>
     <StackPanel DockPanel.Dock="Top"><TextBlock Text="アカウント" FontSize="18" FontWeight="SemiBold"/><TextBox x:Name="Search" TextChanged="Search_Changed" ToolTip="管理名・Riot IDで検索" AutomationProperties.Name="アカウントを検索" Margin="0,14,0,8"/><TextBlock x:Name="AccountReorderHint" Foreground="#597183" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/></StackPanel>
     <Grid>
      <ListBox x:Name="AccountsList" SelectionChanged="Account_Changed" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" KeyboardNavigation.TabNavigation="Continue" AllowDrop="True" PreviewDragOver="Accounts_DragOver" PreviewDragLeave="Accounts_DragLeave" PreviewDrop="Accounts_Drop">
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8,12"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle>
       <ListBox.ItemTemplate><DataTemplate><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button x:Name="ReorderHandle" Width="24" Height="32" Margin="0,0,8,0" Padding="4" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="SizeNS" IsEnabled="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" AutomationProperties.Name="{Binding Label, StringFormat={}{0} の順番を変更}" AutomationProperties.HelpText="ドラッグ、または Alt と上下矢印キーで移動" ToolTip="ドラッグで並べ替え / Alt＋↑・↓" PreviewMouseLeftButtonDown="ReorderHandle_Down" PreviewMouseMove="ReorderHandle_Move" PreviewMouseLeftButtonUp="ReorderHandle_Up" LostMouseCapture="ReorderHandle_LostCapture" PreviewKeyDown="ReorderHandle_KeyDown" QueryContinueDrag="ReorderHandle_QueryContinueDrag">
         <StackPanel Width="14" IsHitTestVisible="False"><Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Height="2" Margin="0,0,0,3"/><Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Height="2" Margin="0,0,0,3"/><Border Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Height="2"/></StackPanel>
        </Button>
        <StackPanel Grid.Column="1"><TextBlock Text="{Binding Label}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RiotId}" Foreground="#597183" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Platform}" Foreground="#597183" FontSize="12" Margin="0,3,0,0"/></StackPanel>
       </Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <Canvas IsHitTestVisible="False" ClipToBounds="True"><Border x:Name="AccountDropIndicator" Height="3" Width="{Binding ActualWidth, ElementName=AccountsList}" Background="#24749B" CornerRadius="1.5" Visibility="Collapsed"/></Canvas>
     </Grid>
    </DockPanel>
   </Border>
   <Grid Grid.Column="2">
    <Border x:Name="EmptyPanel" Background="#E6EEF5" CornerRadius="10" Padding="36"><StackPanel VerticalAlignment="Center"><TextBlock Text="最初のアカウントを登録" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="ログイン情報はこのWindowsユーザーに紐づけて保管します。LoLの情報取得には、設定でAPIキーを登録してください。" FontSize="16" LineHeight="28" Margin="0,16,0,24"/><Button Content="アカウントを追加" Style="{StaticResource Primary}" Click="Add_Click" HorizontalAlignment="Left"/></StackPanel></Border>
    <Grid x:Name="DetailPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Border Background="#DDEAF4" CornerRadius="10" Padding="22">
      <StackPanel>
       <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="編集" Click="Edit_Click"/><Button Content="削除" Click="Delete_Click" Margin="0"/></StackPanel><StackPanel><TextBlock x:Name="AccountTitle" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="AccountIdentity" Foreground="#45647A" Margin="0,5,0,0"/></StackPanel></DockPanel>
       <WrapPanel Margin="0,20,0,0"><Button Content="Riotにログイン" Style="{StaticResource Primary}" Click="Login_Click"/><Button Content="IDをコピー" Click="CopyUser_Click"/><Button Content="パスワードをコピー" Click="CopyPassword_Click"/></WrapPanel>
       <TextBlock Text="別のアカウントからは先にログアウトしてください。追加認証はRiot画面で行います。" FontSize="12" Foreground="#45647A" Margin="0,12,0,0"/>
      </StackPanel>
     </Border>
     <DockPanel Grid.Row="1" Margin="0,18,0,14">
      <Button x:Name="RefreshAnalysisButton" DockPanel.Dock="Right" Content="戦績・分析更新" Click="RefreshAnalysis_Click" Margin="8,0,0,0"/>
      <StackPanel Orientation="Horizontal"><ComboBox x:Name="QueuePicker" Width="150" DisplayMemberPath="Name" SelectedValuePath="Key" AutomationProperties.Name="試合の種類" SelectionChanged="Analysis_Changed" Margin="0,0,10,0"/><ComboBox x:Name="CountPicker" Width="130" SelectionChanged="Analysis_Changed" SelectedIndex="0" Margin="0"><ComboBoxItem Content="直近20戦"/><ComboBoxItem Content="直近50戦"/></ComboBox></StackPanel>
     </DockPanel>
     <TabControl x:Name="DetailTabs" Grid.Row="2" Background="White" BorderBrush="#CDD9E2">
      <TabItem x:Name="OverviewTab" Header="概要"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22">
       <StackPanel x:Name="RankedSummaryPanel"><TextBlock x:Name="RankTitle" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="RankRecord" Foreground="#597183" Margin="0,7,0,0"/><TextBlock x:Name="RankTime" FontSize="12" Foreground="#597183" Margin="0,7,0,22"/></StackPanel>
       <TextBlock x:Name="NormalModeText" Text="ノーマルの成績をまとめて表示します。ドラフト・ブラインド・スイフトプレイ・クイックプレイが対象です。" Foreground="#597183" LineHeight="22" Visibility="Collapsed"/>
       <Border x:Name="ForecastPanel" Background="#F0F5F9" Padding="18" CornerRadius="6"><StackPanel><TextBlock Text="次戦の参考ランク帯" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ForecastRange" FontSize="23" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock x:Name="ForecastDetails" Foreground="#597183" LineHeight="22"/></StackPanel></Border>
       <TextBlock Text="最近の成績" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/><TextBlock x:Name="PerformanceText" FontSize="16" LineHeight="26"/><TextBlock x:Name="UpdatedText" FontSize="12" Foreground="#597183" Margin="0,12,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem x:Name="MatchesTab" Header="試合履歴"><Grid Margin="12"><DataGrid x:Name="MatchesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="40"><DataGrid.Columns><DataGridTextColumn Header="日時" Binding="{Binding When}" Width="100"/><DataGridTextColumn Header="種別" Binding="{Binding Mode}" Width="120"/><DataGridTextColumn Header="結果" Binding="{Binding Result}" Width="55"/><DataGridTextColumn Header="チャンピオン" Binding="{Binding Champion}" Width="*" MinWidth="90"/><DataGridTextColumn Header="K / D / A" Binding="{Binding Kda}" Width="90"/><DataGridTextColumn Header="CS/分" Binding="{Binding Cs}" Width="65"/></DataGrid.Columns></DataGrid></Grid></TabItem>
      <TabItem x:Name="HistoryTab" Header="推移"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="110"/></Grid.RowDefinitions><TextBlock Text="更新した時点のLPを記録します。ランク変更をまたぐ線は接続しません。" Foreground="#597183" Margin="0,0,0,10"/><plot:WpfPlot x:Name="HistoryPlot" Grid.Row="1"/><ListBox x:Name="HistoryList" Grid.Row="2" BorderThickness="0" FontSize="12"/></Grid></TabItem>
      <TabItem Header="分析"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="チャンピオン別" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/><ItemsControl x:Name="ChampionStats"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Margin="0,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="ロール別" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,10"/><ItemsControl x:Name="RoleStats"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" Margin="0,7"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></TabItem>
     </TabControl>
    </Grid>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><Button DockPanel.Dock="Right" x:Name="CancelButton" Content="中止" Click="Cancel_Click" Visibility="Collapsed" Margin="10,0,0,0"/><TextBlock x:Name="StatusText" Text="保存済みデータを表示します。更新はボタンを押したときだけ行います。" Foreground="#597183" VerticalAlignment="Center"/></DockPanel>
 </Grid>
</Window>
